    cout << "\n";

}

Question 13 Implement a Circular Queue using an array

Write a C++ program to implement a Circular Queue using an array.

#include <iostream>

using namespace std;

const int CAPACITY = 5;

class CircularQueue {

    int data[CAPACITY], front = 0, rear = -1, count = 0;

public:

    bool enqueue(int value) {

        if (count == CAPACITY) return false;

        rear = (rear + 1) % CAPACITY; data[rear] = value; ++count; return true;

    }

    bool dequeue(int& value) {

        if (count == 0) return false;

        value = data[front]; front = (front + 1) % CAPACITY; --count; return true;

    }

    void display() const {

        for (int i = 0; i < count; ++i) cout << data[(front + i) % CAPACITY] << " ";

        cout << "\n";

    }

};

int main() {

    CircularQueue q; int value;

    q.enqueue(10); q.enqueue(20); q.enqueue(30);

    q.dequeue(value); q.enqueue(40); q.enqueue(50);

    cout << "Circular queue from Front to Rear: "; q.display();

}

Question 14 Implement Queue using a Linked List

Write a C++ program to implement Queue using a Linked List.

#include <iostream>

using namespace std;

struct Node { int data; Node* next; Node(int v) : data(v), next(nullptr) {} };

class Queue {

    Node* front = nullptr;

    Node* rear = nullptr;

public:

    void enqueue(int value) {

        Node* node = new Node(value);

        if (!rear) front = rear = node;

        else { rear->next = node; rear = node; }

    }

    bool dequeue(int& value) {

        if (!front) return false;

        Node* old = front; value = old->data; front = front->next;

        if (!front) rear = nullptr;

        delete old; return true;

    }

    void display() const {

        for (Node* p = front; p; p = p->next) cout << p->data << " ";

        cout << "\n";

    }

    ~Queue() { int value; while (dequeue(value)) {} }

};

int main() {

    Queue q; int value;

    q.enqueue(10); q.enqueue(20); q.enqueue(30);

    cout << "Front to Rear: "; q.display();

    if (q.dequeue(value)) cout << "Dequeued: " << value << "\n";

    q.display();

}

Question 15 Compare Linear Queue and Circular Queue

Write a C++ program to compare Linear Queue and Circular Queue in terms of space utilization and

#include <iostream>

#include <initializer_list>

using namespace std;

const int CAPACITY = 5;

class LinearQueue {

    int data[CAPACITY], front = 0, rear = -1;

public:

    bool enqueue(int value) {

        if (rear == CAPACITY - 1) return false;

        data[++rear] = value; return true;

    }

    bool dequeue() { if (front > rear) return false; ++front; return true; }

    void display() const {

        for (int i = front; i <= rear; ++i) cout << data[i] << " ";

        cout << "\n";

    }

};

class CircularQueue {

    int data[CAPACITY], front = 0, rear = -1, count = 0;

public:

    bool enqueue(int value) {

        if (count == CAPACITY) return false;

        rear = (rear + 1) % CAPACITY; data[rear] = value; ++count; return true;

    }

    bool dequeue() {

        if (count == 0) return false;

        front = (front + 1) % CAPACITY; --count; return true;

    }

    void display() const {

        for (int i = 0; i < count; ++i) cout << data[(front + i) % CAPACITY] << " ";

        cout << "\n";

    }

};

int main() {

    LinearQueue linear; CircularQueue circular;

    for (int v : {10, 20, 30, 40, 50}) { linear.enqueue(v); circular.enqueue(v); }

    linear.dequeue(); linear.dequeue(); circular.dequeue(); circular.dequeue();

    cout << "Linear enqueue after two deletions: "

         << (linear.enqueue(60) ? "success" : "overflow") << "\n";

    cout << "Circular enqueue after two deletions: "

         << (circular.enqueue(60) ? "success" : "overflow") << "\n";

    cout << "Linear queue: "; linear.display();

    cout << "Circular queue: "; circular.display();

    cout << "Both enqueue and dequeue take O(1); display takes O(n).\n";

    cout << "Circular Queue reuses freed array positions; Linear Queue can leave them unused.\n";

}
