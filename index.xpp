    int stack[CAPACITY], top = -1;

    auto push = [&](int value) {

        if (top == CAPACITY - 1) cout << "Overflow: cannot push " << value << "\n";

        else { stack[++top] = value; cout << "Pushed " << value << "\n"; }

    };

    push(10); push(20); push(30); push(40);

}

