Question 8 Search for an element in a Singly Linked List

Write a C++ program to search for an element in a Singly Linked List.

#include <iostream>

using namespace std;

struct Node { int data; Node* next; Node(int v) : data(v), next(nullptr) {} };

 

int main() {

    Node* head = nullptr;

    int n, value, key, position = 1;

    cout << "Node count: "; cin >> n;

    for (int i = 0; i < n; ++i) {

        cin >> value;

        Node* node = new Node(value);

        if (!head) head = node;

        else { Node* p = head; while (p->next) p = p->next; p->next = node; }

    }

    cout << "Value to search: "; cin >> key;

    Node* p = head;

    while (p && p->data != key) { p = p->next; ++position; }

    if (p) cout << "Found at position " << position << "\n";

    else cout << "Not found\n";

    while (head) { Node* old = head; head = head->next; delete old; }

}

