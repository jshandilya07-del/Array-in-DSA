    return n * factorial(n - 1);

}

int main() {

    int n;

    cout << "Enter n (0 to 20): "; cin >> n;

    if (n < 0 || n > 20) { cout << "Invalid input\n"; return 0; }

    cout << n << "! = " << factorial(n) << "\n";

    cout << "Each recursive call uses a call-stack frame.\n";

}

Question 15 Analyze the time complexity of Stack operations

Write a C++ program to analyze the time complexity of Push, Pop, Peek, and Display operations.

#include <iostream>

using namespace std;

const int CAPACITY = 5;

class Stack {

    int data[CAPACITY], topIndex = -1;

public:

    bool push(int value) {

        if (topIndex == CAPACITY - 1) return false;

        data[++topIndex] = value; return true;

    }

    bool pop(int& value) {

        if (topIndex == -1) return false;

        value = data[topIndex--]; return true;

    }

    bool peek(int& value) const {

        if (topIndex == -1) return false;

        value = data[topIndex]; return true;

    }

    void display() const {

        for (int i = topIndex; i >= 0; --i) cout << data[i] << " ";

        cout << "\n";

    }

};

int main() {

    Stack s; int value;

    s.push(10); s.push(20); s.push(30);

    s.peek(value); s.pop(value); s.display();

    cout << "Push: O(1)\nPop: O(1)\nPeek: O(1)\nDisplay: O(n)\n";

}

