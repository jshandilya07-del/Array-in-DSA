Lab Exercises

Question 1 Create and display a Singly Linked List

Write a C++ program to create and display a Singly Linked List.

#include <iostream>

using namespace std;

 

struct Node {

    int data;

    Node* next;

    explicit Node(int value) : data(value), next(nullptr) {}

};

 

int main() {

    Node* head = nullptr;

    Node* tail = nullptr;

    int n;

    cout << "Number of nodes: ";

    if (!(cin >> n) || n < 0) return 0;

    for (int i = 0, value; i < n; ++i) {

        cout << "Value: ";

        cin >> value;

        Node* node = new Node(value);

        if (!head) head = tail = node;

        else { tail->next = node; tail = node; }

    }

    cout << "List: ";

    for (Node* p = head; p; p = p->next) cout << p->data << " ";

    cout << "\n";

    while (head) { Node* old = head; head = head->next; delete old; }

}

Question 2 Insert a node at the beginning

Write a C++ program to insert a node at the beginning of a Linked List.

#include <iostream>

using namespace std;

struct Node { int data; Node* next; Node(int v) : data(v), next(nullptr) {} };

 

int main() {

    Node* head = nullptr;

    int n, value;

    cout << "Initial node count: "; cin >> n;

    for (int i = 0; i < n; ++i) {

        cin >> value;

        Node* node = new Node(value);

        if (!head) head = node;

        else { Node* p = head; while (p->next) p = p->next; p->next = node; }

    }

    cout << "Value to insert at beginning: "; cin >> value;

    Node* node = new Node(value);

    node->next = head;

    head = node;

    for (Node* p = head; p; p = p->next) cout << p->data << " ";

    cout << "\n";

    while (head) { Node* old = head; head = head->next; delete old; }

}

