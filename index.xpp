Question 10 Find the maximum and minimum element

Write a C++ program to find the maximum and minimum element in a Linked List.

#include <iostream>

using namespace std;

struct Node { int data; Node* next; Node(int v) : data(v), next(nullptr) {} };

 

int main() {

    Node* head = nullptr;

    Node* tail = nullptr;

    int n, value;

    cout << "Node count: "; cin >> n;

    for (int i = 0; i < n; ++i) {

        cin >> value;

        Node* node = new Node(value);

        if (!head) head = tail = node;

        else { tail->next = node; tail = node; }

    }

    if (!head) cout << "List is empty\n";

    else {

        int smallest = head->data, largest = head->data;

        for (Node* p = head->next; p; p = p->next) {

            if (p->data < smallest) smallest = p->data;

            if (p->data > largest) largest = p->data;

        }

        cout << "Minimum: " << smallest << "\nMaximum: " << largest << "\n";

    }

    while (head) { Node* old = head; head = head->next; delete old; }

}

Question 11 Reverse a Singly Linked List

Write a C++ program to reverse a Singly Linked List.

#include <iostream>

using namespace std;

struct Node { int data; Node* next; Node(int v) : data(v), next(nullptr) {} };

 

int main() {

    Node* head = nullptr;

    Node* tail = nullptr;

    int n, value;

    cout << "Node count: "; cin >> n;

    for (int i = 0; i < n; ++i) {

        cin >> value; Node* node = new Node(value);

        if (!head) head = tail = node;

        else { tail->next = node; tail = node; }

    }

    Node* previous = nullptr;

    Node* current = head;

    while (current) {

        Node* nextNode = current->next;

        current->next = previous;

        previous = current;

        current = nextNode;

    }

    head = previous;

    cout << "Reversed list: ";

    for (Node* p = head; p; p = p->next) cout << p->data << " ";

    cout << "\n";

    while (head) { Node* old = head; head = head->next; delete old; }

}

Question 12 Sort the elements in ascending order

Write a C++ program to sort the elements of a Linked List in ascending order.

#include <iostream>

#include <utility>

using namespace std;

struct Node { int data; Node* next; Node(int v) : data(v), next(nullptr) {} };

 

int main() {

    Node* head = nullptr;

    Node* tail = nullptr;

    int n, value;

    cout << "Node count: "; cin >> n;

    for (int i = 0; i < n; ++i) {

        cin >> value; Node* node = new Node(value);

        if (!head) head = tail = node;

        else { tail->next = node; tail = node; }

    }

    for (Node* i = head; i; i = i->next)

        for (Node* j = i->next; j; j = j->next)

            if (i->data > j->data) swap(i->data, j->data);

    cout << "Sorted list: ";

    for (Node* p = head; p; p = p->next) cout << p->data << " ";

    cout << "\n";

    while (head) { Node* old = head; head = head->next; delete old; }

}

Question 13 Menu-driven insertion deletion searching and display

Write a menu-driven C++ program implementing insertion, deletion, searching and display operations.

#include <iostream>

using namespace std;

struct Node { int data; Node* next; Node(int v) : data(v), next(nullptr) {} };

 

void display(Node* head) {

    if (!head) cout << "List is empty\n";

    for (Node* p = head; p; p = p->next) cout << p->data << " ";

    cout << "\n";

}

void insertAt(Node*& head, int value, int position) {

    if (position < 1) { cout << "Invalid position\n"; return; }

    if (position == 1) { Node* node = new Node(value); node->next = head; head = node; return; }

    Node* p = head;

    for (int i = 1; p && i < position - 1; ++i) p = p->next;

    if (!p) { cout << "Invalid position\n"; return; }

    Node* node = new Node(value); node->next = p->next; p->next = node;

}

void deleteAt(Node*& head, int position) {

    if (!head || position < 1) { cout << "Invalid position or empty list\n"; return; }

    if (position == 1) { Node* old = head; head = head->next; delete old; return; }

    Node* p = head;

    for (int i = 1; p->next && i < position - 1; ++i) p = p->next;

    if (!p->next) { cout << "Invalid position\n"; return; }

    Node* old = p->next; p->next = old->next; delete old;

}

int main() {

    Node* head = nullptr;

    int choice, value, position;

    do {

        cout << "1 Insert  2 Delete  3 Search  4 Display  0 Exit\nChoice: ";

        cin >> choice;

        if (choice == 1) {

            cout << "Value and position: "; cin >> value >> position;

            insertAt(head, value, position);

        } else if (choice == 2) {

            cout << "Position: "; cin >> position; deleteAt(head, position);

        } else if (choice == 3) {

            cout << "Value to search: "; cin >> value;

            int i = 1; Node* p = head;

            while (p && p->data != value) { p = p->next; ++i; }

            if (p) cout << "Found at position " << i << "\n";

            else cout << "Not found\n";

        } else if (choice == 4) display(head);

    } while (choice != 0);

    while (head) { Node* old = head; head = head->next; delete old; }

}

Question 14 Doubly Linked List insertion and deletion

Write a C++ program to implement a Doubly Linked List and perform insertion and deletion operations.

#include <iostream>

using namespace std;

struct Node { int data; Node* prev; Node* next; Node(int v) : data(v), prev(nullptr), next(nullptr) {} };

 

void insertAt(Node*& head, int value, int position) {

    if (position < 1) { cout << "Invalid position\n"; return; }

    Node* node = new Node(value);

    if (position == 1) {

        node->next = head;

        if (head) head->prev = node;

        head = node;

        return;

    }

    Node* p = head;

    for (int i = 1; p && i < position - 1; ++i) p = p->next;

    if (!p) { delete node; cout << "Invalid position\n"; return; }

    node->next = p->next; node->prev = p;

    if (p->next) p->next->prev = node;

    p->next = node;

}

void deleteAt(Node*& head, int position) {

    if (position < 1 || !head) { cout << "Invalid position or empty list\n"; return; }

    Node* p = head;

    for (int i = 1; p && i < position; ++i) p = p->next;

    if (!p) { cout << "Invalid position\n"; return; }

    if (p->prev) p->prev->next = p->next; else head = p->next;

    if (p->next) p->next->prev = p->prev;

    delete p;

}

int main() {

    Node* head = nullptr;

    int choice, value, position;

    do {

        cout << "1 Insert  2 Delete  3 Display  0 Exit\nChoice: "; cin >> choice;

        if (choice == 1) {

            cout << "Value and position: "; cin >> value >> position;

            insertAt(head, value, position);

        } else if (choice == 2) {

            cout << "Position: "; cin >> position; deleteAt(head, position);

        } else if (choice == 3) {

            for (Node* p = head; p; p = p->next) cout << p->data << " ";

            cout << "\n";

        }

    } while (choice != 0);

    while (head) { Node* old = head; head = head->next; delete old; }

}

Question 15 Circular Linked List traversal and insertion

Write a C++ program to implement a Circular Linked List and perform traversal and insertion operations.

#include <iostream>

using namespace std;

struct Node { int data; Node* next; Node(int v) : data(v), next(nullptr) {} };

 

void insertAt(Node*& head, int value, int position) {

    if (position < 1) { cout << "Invalid position\n"; return; }

    Node* node = new Node(value);

    if (!head) {

        if (position != 1) { delete node; cout << "Invalid position\n"; return; }

        node->next = node; head = node; return;

    }

    if (position == 1) {

        Node* tail = head; while (tail->next != head) tail = tail->next;

        node->next = head; tail->next = node; head = node; return;

    }

    Node* p = head;

    for (int i = 1; i < position - 1; ++i) {

        p = p->next;

        if (p == head) { delete node; cout << "Invalid position\n"; return; }

    }

    node->next = p->next; p->next = node;

}

void display(Node* head) {

    if (!head) { cout << "List is empty\n"; return; }

    Node* p = head;

    do { cout << p->data << " "; p = p->next; } while (p != head);

    cout << "\n";

}

void clear(Node*& head) {

    if (!head) return;

    Node* p = head->next;

    while (p != head) { Node* next = p->next; delete p; p = next; }

    delete head; head = nullptr;

}

int main() {

    Node* head = nullptr;

    int n, value, position;

    cout << "Initial node count: "; cin >> n;

    for (int i = 1; i <= n; ++i) { cin >> value; insertAt(head, value, i); }

    cout << "Value and position to insert: "; cin >> value >> position;

    insertAt(head, value, position);

    cout << "Circular list: "; display(head);

    clear(head);

}

Practice and Analysis Questions

Question 1 What is a Linked List and how is it different from an array

What is a Linked List and how is it different from an array?

Answer: A linked list is a sequence of nodes. Each node stores data and a link to another node. Array elements occupy consecutive memory locations and can be accessed by index in O(1) time. A linked list grows node by node, so reaching an item by position takes O(n). Insertion and deletion can be O(1) when the target node or its predecessor is already known; arrays often need elements shifted.

Question 2 What is a node in a Linked List

What is a node in a Linked List?

Answer: A node is one element of a linked list. In a singly linked list it contains a data value and a pointer to the next node. Other list types may store additional links, such as a pointer to the previous node.

Question 3 What is the role of the Head pointer

What is the role of the Head pointer?

Answer: The head pointer stores the address of the first node. Traversal starts at head. If head is nullptr, the list is empty. Losing the head pointer can make the remaining nodes unreachable.

Question 4 What is dynamic memory allocation

What is dynamic memory allocation?

Answer: Dynamic memory allocation reserves memory while a program is running. In C++, new can allocate a node on the free store and delete releases it when it is no longer needed. Linked lists use it to grow or shrink without choosing a fixed capacity in advance.

Question 5 What is the difference between Singly and Doubly Linked Lists

What is the difference between Singly and Doubly Linked Lists?

Answer: A singly linked list stores a next pointer and supports forward traversal. A doubly linked list stores both next and previous pointers and supports traversal in both directions. The extra pointer uses more memory, but it makes some deletions and backward movement easier.

Question 6 What is the time complexity of insertion at the beginning

What is the time complexity of insertion at the beginning?

Answer: Insertion at the beginning takes O(1) time. The new node points to the old head, and head is updated; the number of existing nodes does not affect the work.

Question 7 Why does insertion at the end take O(n) with only a Head pointer

Why does insertion at the end take O(n) with only a Head pointer?

Answer: With only a head pointer, the program must follow next links until it reaches the last node. That traversal takes O(n). Keeping a tail pointer allows insertion at the end in O(1) time.

Question 8 What is the time complexity of searching in a Linked List

What is the time complexity of searching in a Linked List?

Answer: Searching takes O(n) time in the worst case because each node may need to be checked. It takes O(1) if the value is in the first node, but the worst-case bound is linear.

Question 9 What happens when Head == NULL

What happens when Head == NULL?

Answer: The list is empty; there is no first node to traverse, display, or delete.

Question 10 What are the advantages and disadvantages of Linked Lists

What are the advantages and disadvantages of Linked Lists?

Answer: Linked lists can grow or shrink dynamically, and insertion or deletion is efficient when the relevant node is already known. They do not provide direct index access, require extra memory for links, and can have poorer cache locality than arrays. Searching by value still takes O(n).

Question 11 How can a Linked List be used to implement a Stack

How can a Linked List be used to implement a Stack?

Answer: Use the head node as the top of the stack. Push inserts a node at the head, and pop removes the head. Both operations take O(1) time and need no fixed array capacity, subject to available memory.

Question 12 How can a Linked List be used to implement a Queue

How can a Linked List be used to implement a Queue?

Answer: Keep pointers to both the first node (front) and last node (rear). Enqueue adds a node after rear and updates rear. Dequeue removes the front node and updates front. With both pointers, each operation takes O(1) time.

Question 13 What is a Circular Linked List

What is a Circular Linked List?

Answer: A circular linked list links its last node back to its first node. In a singly circular list, the tail node's next pointer equals head, so traversal must stop when it returns to the starting node.

Question 14 What is the difference between Linear and Circular Linked Lists

What is the difference between Linear and Circular Linked Lists?

Answer: In a linear linked list, the last node points to nullptr. In a circular linked list, the last node points back to the first node. Linear traversal ends at nullptr; circular traversal ends when it reaches the starting node again.

Question 15 Compare Array and Linked List in terms of memory allocation access insertion and deletion

Compare Array and Linked List in terms of memory allocation, access, insertion and deletion.

Answer: Arrays store elements contiguously and commonly use a fixed capacity, though dynamic arrays can resize. They support O(1) indexed access. Linked lists allocate nodes as needed and use extra pointer memory; indexed access takes O(n). Inserting or deleting in the middle of an array may require shifting O(n) elements, while a linked-list link change is O(1) after the target location has been found. Finding that location still takes O(n).

Lab Sheet 5 Stacks

Lab Exercises

Question 1 Implement a Stack using an array with basic operations

Write a C++ program to implement a Stack using an array with Push, Pop, Peek, and Display operations.

#include <iostream>

using namespace std;

const int CAPACITY = 5;

class Stack {

    int data[CAPACITY], topIndex = -1;

public:

    bool push(int value) {

        if (topIndex == CAPACITY - 1) return false;

        data[++topIndex] = value; return true;

    }

    bool pop(int& value) {

        if (topIndex == -1) return false;

        value = data[topIndex--]; return true;

    }

    bool peek(int& value) const {

        if (topIndex == -1) return false;

        value = data[topIndex]; return true;

    }

    void display() const {

        if (topIndex == -1) { cout << "Stack is empty\n"; return; }

        for (int i = topIndex; i >= 0; --i) cout << data[i] << " ";

        cout << "<- TOP\n";

    }

};

int main() {

    Stack s; int value;

    s.push(10); s.push(20); s.push(30);

    cout << "Stack: "; s.display();

    if (s.peek(value)) cout << "Top: " << value << "\n";

    if (s.pop(value)) cout << "Popped: " << value << "\n";

    cout << "After pop: "; s.display();

}

