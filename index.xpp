Question 4 Insert a node at a given position

Write a C++ program to insert a node at a given position.

#include <iostream>

using namespace std;

struct Node { int data; Node* next; Node(int v) : data(v), next(nullptr) {} };

 

int main() {

    Node* head = nullptr;

    int n, value, position;

    cout << "Initial node count: "; cin >> n;

    for (int i = 0; i < n; ++i) {

        cin >> value;

        Node* node = new Node(value);

        if (!head) head = node;

        else { Node* p = head; while (p->next) p = p->next; p->next = node; }

    }

    cout << "Position (1 to " << n + 1 << "): "; cin >> position;

    cout << "Value: "; cin >> value;

    if (position < 1 || position > n + 1) cout << "Invalid position\n";

    else if (position == 1) { Node* node = new Node(value); node->next = head; head = node; }

    else {

        Node* p = head;

        for (int i = 1; i < position - 1; ++i) p = p->next;

        Node* node = new Node(value); node->next = p->next; p->next = node;

    }

    for (Node* p = head; p; p = p->next) cout << p->data << " ";

    cout << "\n";

    while (head) { Node* old = head; head = head->next; delete old; }

}

Question 5 Delete a node from the beginning

Write a C++ program to delete a node from the beginning.

#include <iostream>

using namespace std;

struct Node { int data; Node* next; Node(int v) : data(v), next(nullptr) {} };

 

int main() {

    Node* head = nullptr;

    int n, value;

    cout << "Node count: "; cin >> n;

    for (int i = 0; i < n; ++i) {

        cin >> value;

        Node* node = new Node(value);

        if (!head) head = node;

        else { Node* p = head; while (p->next) p = p->next; p->next = node; }

    }

    if (!head) cout << "List is empty\n";

    else { Node* old = head; head = head->next; delete old; cout << "First node deleted\n"; }

    for (Node* p = head; p; p = p->next) cout << p->data << " ";

    cout << "\n";

    while (head) { Node* old = head; head = head->next; delete old; }

}

Question 6 Delete a node from the end

Write a C++ program to delete a node from the end.

#include <iostream>

using namespace std;

struct Node { int data; Node* next; Node(int v) : data(v), next(nullptr) {} };

 

int main() {

    Node* head = nullptr;

    int n, value;

    cout << "Node count: "; cin >> n;

    for (int i = 0; i < n; ++i) {

        cin >> value;

        Node* node = new Node(value);

        if (!head) head = node;

        else { Node* p = head; while (p->next) p = p->next; p->next = node; }

    }

    if (!head) cout << "List is empty\n";

    else if (!head->next) { delete head; head = nullptr; }

    else {

        Node* p = head;

        while (p->next->next) p = p->next;

        delete p->next; p->next = nullptr;

    }

    cout << "List after deleting the last node: ";

    for (Node* p = head; p; p = p->next) cout << p->data << " ";

    cout << "\n";

    while (head) { Node* old = head; head = head->next; delete old; }

}

Question 7 Delete a node from a given position

Write a C++ program to delete a node from a given position.

