Question 8 Check balanced parentheses using Stack

Write a C++ program to check balanced parentheses using Stack.

#include <iostream>

#include <stack>

#include <string>

using namespace std;

bool matches(char open, char close) {

    return (open == '(' && close == ')') || (open == '[' && close == ']') ||

           (open == '{' && close == '}');

}

int main() {

    string expression;

    stack<char> opens;

    cout << "Expression: "; getline(cin, expression);

    bool balanced = true;

    for (char ch : expression) {

        if (ch == '(' || ch == '[' || ch == '{') opens.push(ch);

        else if (ch == ')' || ch == ']' || ch == '}') {

            if (opens.empty() || !matches(opens.top(), ch)) { balanced = false; break; }

            opens.pop();

        }

    }

    balanced = balanced && opens.empty();

    cout << (balanced ? "Balanced\n" : "Not balanced\n");

}

Question 9 Convert an Infix expression into Postfix

Write a C++ program to convert an Infix expression into Postfix using Stack.

#include <cctype>

#include <iostream>

#include <stack>

#include <string>

using namespace std;

int precedence(char op) {

    if (op == '^') return 3;

    if (op == '*' || op == '/') return 2;

    if (op == '+' || op == '-') return 1;

    return 0;

}

bool rightAssociative(char op) { return op == '^'; }

int main() {

    string infix, postfix;

    stack<char> ops;

    cout << "Infix expression (single-letter/digit operands): "; getline(cin, infix);

    bool valid = true;

    for (char ch : infix) {

        if (isspace(static_cast<unsigned char>(ch))) continue;

        if (isalnum(static_cast<unsigned char>(ch))) { postfix += ch; postfix += ' '; }

        else if (ch == '(') ops.push(ch);

        else if (ch == ')') {

            while (!ops.empty() && ops.top() != '(') { postfix += ops.top(); postfix += ' '; ops.pop(); }

            if (ops.empty()) { valid = false; break; }

            ops.pop();

        } else if (ch == '+' || ch == '-' || ch == '*' || ch == '/' || ch == '^') {

            while (!ops.empty() && ops.top() != '(' &&

                   (precedence(ops.top()) > precedence(ch) ||

                    (precedence(ops.top()) == precedence(ch) && !rightAssociative(ch)))) {

                postfix += ops.top(); postfix += ' '; ops.pop();

            }

            ops.push(ch);

        } else { valid = false; break; }

    }

    while (valid && !ops.empty()) {

        if (ops.top() == '(') { valid = false; break; }

        postfix += ops.top(); postfix += ' '; ops.pop();

    }

    if (valid) cout << "Postfix: " << postfix << "\n";

    else cout << "Invalid expression\n";

}

Question 10 Evaluate a Postfix expression

Write a C++ program to evaluate a Postfix expression using Stack.

#include <iostream>

#include <sstream>

#include <stack>

#include <string>

using namespace std;

int main() {

    string line, token;

    stack<long long> values;

    cout << "Enter space-separated postfix tokens, for example 12 3 +: ";

    getline(cin, line);

    istringstream input(line);

    bool valid = true;

    while (input >> token) {

        if (token.size() > 1 || (token[0] >= '0' && token[0] <= '9')) {

            try { size_t used; long long value = stoll(token, &used);

                if (used != token.size()) { valid = false; break; }

                values.push(value);

            } catch (...) { valid = false; break; }

        } else if (token.size() == 1 && string("+-*/^").find(token[0]) != string::npos) {

            if (values.size() < 2) { valid = false; break; }

            long long b = values.top(); values.pop();

            long long a = values.top(); values.pop();

            switch (token[0]) {

                case '+': values.push(a + b); break;

                case '-': values.push(a - b); break;

                case '*': values.push(a * b); break;

                case '/': if (b == 0) valid = false; else values.push(a / b); break;

                case '^': { long long r = 1; if (b < 0) valid = false;

                    else { for (long long i = 0; i < b; ++i) r *= a; values.push(r); } break; }

            }

            if (!valid) break;

        } else { valid = false; break; }

    }

    if (!valid || values.size() != 1) cout << "Invalid postfix expression\n";

    else cout << "Result: " << values.top() << "\n";

}

Question 11 Convert an Infix expression into Prefix

Write a C++ program to convert an Infix expression into Prefix using Stack.

#include <cctype>

#include <iostream>

#include <sstream>

#include <stack>

#include <string>

using namespace std;

int precedence(char op) {

    if (op == '^') return 3;

    if (op == '*' || op == '/') return 2;

    if (op == '+' || op == '-') return 1;

    return 0;

}

int main() {

    string infix, postfix;

    stack<char> ops;

    stack<string> expressions;

    cout << "Infix expression (single-letter/digit operands): "; getline(cin, infix);

    bool valid = true;

    for (char ch : infix) {

        if (isspace(static_cast<unsigned char>(ch))) continue;

        if (isalnum(static_cast<unsigned char>(ch))) { postfix += ch; postfix += ' '; }

        else if (ch == '(') ops.push(ch);

        else if (ch == ')') {

            while (!ops.empty() && ops.top() != '(') { postfix += ops.top(); postfix += ' '; ops.pop(); }

            if (ops.empty()) { valid = false; break; } ops.pop();

        } else if (ch == '+' || ch == '-' || ch == '*' || ch == '/' || ch == '^') {

            while (!ops.empty() && ops.top() != '(' &&

                   (precedence(ops.top()) > precedence(ch) ||

                    (precedence(ops.top()) == precedence(ch) && ch != '^'))) {

                postfix += ops.top(); postfix += ' '; ops.pop();

            }

            ops.push(ch);

        } else { valid = false; break; }

    }

    while (valid && !ops.empty()) {

        if (ops.top() == '(') { valid = false; break; }

        postfix += ops.top(); postfix += ' '; ops.pop();

    }

    istringstream input(postfix);

    string token;

    while (valid && input >> token) {

        if (token.size() == 1 && string("+-*/^").find(token[0]) != string::npos) {

            if (expressions.size() < 2) { valid = false; break; }

            string right = expressions.top(); expressions.pop();

            string left = expressions.top(); expressions.pop();

            expressions.push(token + " " + left + " " + right);

        } else expressions.push(token);

    }

    if (!valid || expressions.size() != 1) cout << "Invalid expression\n";

    else cout << "Prefix: " << expressions.top() << "\n";

}

Question 12 Implement two stacks in a single array

Write a C++ program to implement two stacks in a single array.

#include <iostream>

using namespace std;

const int CAPACITY = 10;

int data[CAPACITY], top1 = -1, top2 = CAPACITY;

bool push1(int value) { if (top1 + 1 == top2) return false; data[++top1] = value; return true; }

bool push2(int value) { if (top1 + 1 == top2) return false; data[--top2] = value; return true; }

bool pop1(int& value) { if (top1 == -1) return false; value = data[top1--]; return true; }

bool pop2(int& value) { if (top2 == CAPACITY) return false; value = data[top2++]; return true; }

int main() {

    int value;

    push1(10); push1(20); push2(90); push2(80);

    if (pop1(value)) cout << "Popped from Stack 1: " << value << "\n";

    if (pop2(value)) cout << "Popped from Stack 2: " << value << "\n";

}

