Question 1 Implement a Queue using an array

Write a C++ program to implement a Queue using an array. Perform Enqueue, Dequeue, Peek and Display operations.

#include <iostream>

using namespace std;

const int CAPACITY = 5;

class Queue {

    int data[CAPACITY], frontIndex = 0, rear = -1;

public:

    bool enqueue(int value) {

        if (rear == CAPACITY - 1) return false;

        data[++rear] = value; return true;

    }

    bool dequeue(int& value) {

        if (frontIndex > rear) return false;

        value = data[frontIndex++]; return true;

    }

    bool peek(int& value) const {

        if (frontIndex > rear) return false;

        value = data[frontIndex]; return true;

    }

    void display() const {

        if (frontIndex > rear) { cout << "Queue is empty\n"; return; }

        for (int i = frontIndex; i <= rear; ++i) cout << data[i] << " ";

        cout << "\n";

    }

};

int main() {

    Queue q; int value;

    q.enqueue(10); q.enqueue(20); q.enqueue(30);

    cout << "Front to rear: "; q.display();

    if (q.peek(value)) cout << "Front: " << value << "\n";

    if (q.dequeue(value)) cout << "Removed: " << value << "\n";

    q.display();

}

